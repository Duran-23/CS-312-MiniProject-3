<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>The Blog</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/">CS-312 Blog</a>
      <div class="navbar-nav ms-auto">
        <% if (user) { %>
          <span class="navbar-text text-light me-3">Welcome, <%= user.name %></span>
          <a class="btn btn-outline-light btn-sm" href="/logout">Logout</a>
        <% } else { %>
          <a class="btn btn-outline-light btn-sm me-2" href="/signin">Sign In</a>
          <a class="btn btn-success btn-sm" href="/signup">Sign Up</a>
        <% } %>
      </div>
    </div>
  </nav>
  <div class="container mb-5">